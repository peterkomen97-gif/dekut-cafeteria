# dekut-cafeteria
University Cafeteria Management System

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="DeKUT Cafeteria - Explore university dining, menus and catering services.">
    <title>DeKUT Cafeteria | University Dining</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f8faf8;
            color: #24352b;
            line-height: 1.6;
        }

        :root {
            --green: #176b3a;
            --dark-green: #104d2b;
            --light-green: #eaf4ed;
            --gold: #e8b84c;
            --white: #ffffff;
        }

        /* NAVIGATION */

        header {
            background: var(--white);
            padding: 16px 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 23px;
            font-weight: 800;
            color: var(--green);
        }

        .logo span {
            color: var(--gold);
        }

        nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        nav a {
            text-decoration: none;
            color: #35443a;
            font-weight: 600;
            font-size: 14px;
        }

        nav a:hover {
            color: var(--green);
        }

        .nav-button {
            background: var(--green);
            color: white;
            padding: 11px 19px;
            border-radius: 6px;
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 27px;
            cursor: pointer;
        }

        /* HERO SECTION */

        .hero {
            min-height: 520px;
            display: flex;
            align-items: center;
            padding: 75px 8%;
            background:
                linear-gradient(90deg,
                rgba(8, 39, 23, 0.91),
                rgba(8, 39, 23, 0.42)),
                url("https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1800&q=85")
                center/cover;
            color: white;
        }

        .hero-content {
            max-width: 650px;
        }

        .hero-label {
            color: var(--gold);
            font-weight: bold;
            letter-spacing: 2px;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .hero h1 {
            font-size: clamp(38px, 6vw, 60px);
            line-height: 1.15;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 17px;
            color: #e5eee7;
            margin-bottom: 30px;
            max-width: 550px;
        }

        .primary-button {
            display: inline-block;
            padding: 14px 25px;
            background: var(--gold);
            color: #253326;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            transition: 0.3s;
        }

        .primary-button:hover {
            background: white;
            transform: translateY(-2px);
        }

        /* GENERAL SECTIONS */

        section {
            padding: 75px 8%;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 42px;
        }

        .section-heading small {
            color: var(--green);
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .section-heading h2 {
            font-size: 34px;
            color: #183c27;
            margin: 10px 0;
        }

        .section-heading p {
            color: #718078;
        }

        /* CAFETERIA CARDS */

        .cafeteria-section {
            background: #f8faf8;
        }

        .cafeteria-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .cafe-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
            transition: 0.3s;
        }

        .cafe-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.11);
        }

        .cafe-card img {
            width: 100%;
            height: 210px;
            object-fit: cover;
        }

        .card-content {
            padding: 24px;
        }

        .card-content h3 {
            color: var(--green);
            font-size: 21px;
            margin-bottom: 10px;
        }

        .card-content p {
            color: #718078;
            font-size: 14px;
            min-height: 65px;
            margin-bottom: 20px;
        }

        .menu-button {
            width: 100%;
            padding: 12px;
            border: none;
            background: var(--green);
            color: white;
            font-size: 15px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.3s;
        }

        .menu-button:hover {
            background: var(--dark-green);
        }

        /* ABOUT */

        .about-section {
            background: white;
        }

        .about-content {
            max-width: 850px;
            margin: auto;
            text-align: center;
        }

        .about-content p {
            color: #718078;
            margin-top: 15px;
            font-size: 16px;
        }

        .features {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 35px;
        }

        .feature {
            background: var(--light-green);
            padding: 25px;
            border-radius: 10px;
        }

        .feature .icon {
            font-size: 32px;
        }

        .feature h3 {
            color: var(--green);
            margin: 10px 0;
        }

        .feature p {
            font-size: 14px;
            color: #718078;
        }

        /* CONTACT */

        .contact-section {
            background: var(--light-green);
        }

        .contact-content {
            text-align: center;
            max-width: 600px;
            margin: auto;
        }

        .contact-content p {
            color: #64756a;
            margin: 15px 0;
        }

        .contact-email {
            display: inline-block;
            color: var(--green);
            font-weight: bold;
            text-decoration: none;
            margin-top: 10px;
        }

        /* FOOTER */

        footer {
            background: #102e1c;
            color: white;
            padding: 35px 8%;
            text-align: center;
        }

        footer p {
            color: #c4d1c7;
            font-size: 14px;
        }

        footer .footer-logo {
            font-size: 23px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        /* MENU MODAL */

        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.65);
            z-index: 200;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: white;
            padding: 30px;
            border-radius: 12px;
            max-width: 450px;
            width: 100%;
            position: relative;
        }

        .modal-content h2 {
            color: var(--green);
            margin-bottom: 15px;
        }

        .modal-content ul {
            padding-left: 20px;
            margin: 15px 0;
        }

        .modal-content li {
            margin-bottom: 8px;
        }

        .close-modal {
            position: absolute;
            top: 12px;
            right: 17px;
            border: none;
            background: none;
            font-size: 26px;
            cursor: pointer;
        }

        .demo-note {
            font-size: 12px;
            color: #888;
            margin-top: 15px;
        }

        /* MOBILE RESPONSIVENESS */

        @media (max-width: 850px) {
            .cafeteria-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .features {
                grid-template-columns: 1fr;
            }

            nav {
                gap: 15px;
            }
        }

        @media (max-width: 600px) {
            header {
                padding: 15px 5%;
            }

            .menu-toggle {
                display: block;
            }

            nav {
                display: none;
                position: absolute;
                top: 65px;
                left: 0;
                width: 100%;
                background: white;
                padding: 20px;
                flex-direction: column;
                align-items: stretch;
                box-shadow: 0 5px 10px rgba(0,0,0,0.08);
            }

            nav.active {
                display: flex;
            }

            nav a {
                padding: 8px;
            }

            .hero {
                min-height: 480px;
                padding: 55px 6%;
            }

            .cafeteria-grid {
                grid-template-columns: 1fr;
            }

            section {
                padding: 55px 6%;
            }

            .section-heading h2 {
                font-size: 27px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVIGATION -->
    <header>
        <div class="logo">DeKUT<span> Cafeteria</span></div>

        <button class="menu-toggle" id="menuToggle"
                aria-label="Toggle navigation"
                aria-expanded="false">
            ☰
        </button>

        <nav id="navigation">
            <a href="#home">Home</a>
            <a href="#cafeterias">Our Cafeterias</a>
            <a href="#about">About Us</a>
            <a href="#contact">Contact</a>
            <a href="#cafeterias" class="nav-button">Explore Menus</a>
        </nav>
    </header>

    <!-- HERO -->
    <main>
        <section class="hero" id="home">
            <div class="hero-content">
                <div class="hero-label">DEDAN KIMATHI UNIVERSITY OF TECHNOLOGY</div>

                <h1>Good Food.<br>Great Campus Experience.</h1>

                <p>
                    Welcome to DeKUT Cafeteria. Discover our dining
                    locations, explore delicious meals and enjoy
                    convenient campus dining.
                </p>

                <a href="#cafeterias" class="primary-button">
                    Explore Our Cafeterias →
                </a>
            </div>
        </section>

        <!-- CAFETERIAS -->
        <section class="cafeteria-section" id="cafeterias">

            <div class="section-heading">
                <small>Discover Our Dining Locations</small>
                <h2>Our Cafeterias</h2>
                <p>Choose your preferred dining location and explore its menu.</p>
            </div>

            <div class="cafeteria-grid">

                <!-- MESS A -->
                <article class="cafe-card">
                    <img
                        src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&w=900&q=80"
                        alt="Delicious cafeteria meal">

                    <div class="card-content">
                        <h3>Mess A (Lower Mess)</h3>
                        <p>
                            Enjoy a variety of delicious meals
                            and affordable campus dining options.
                        </p>

                        <button class="menu-button"
                                onclick="showMenu('Mess A (Lower Mess)')">
                            View Menu →
                        </button>
                    </div>
                </article>

                <!-- MESS B -->
                <article class="cafe-card">
                    <img
                        src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=80"
                        alt="Fresh food served in a cafeteria">

                    <div class="card-content">
                        <h3>Mess B (Upper Mess)</h3>
                        <p>
                            Explore a selection of meals with
                            diverse flavours and dining experiences.
                        </p>

                        <button class="menu-button"
                                onclick="showMenu('Mess B (Upper Mess)')">
                            View Menu →
                        </button>
                    </div>
                </article>

                <!-- STAFF CAFE -->
                <article class="cafe-card">
                    <img
                        src="https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=900&q=80"
                        alt="Modern cafe interior">

                    <div class="card-content">
                        <h3>Staff Cafe</h3>
                        <p>
                            A comfortable dining environment
                            for university faculty and staff.
                        </p>

                        <button class="menu-button"
                                onclick="showMenu('Staff Cafe')">
                            View Menu →
                        </button>
                    </div>
                </article>

            </div>
        </section>

        <!-- ABOUT -->
        <section class="about-section" id="about">

            <div class="about-content">
                <div class="section-heading">
                    <small>Who We Are</small>
                    <h2>About DeKUT Catering</h2>
                </div>

                <p>
                    DeKUT Cafeteria is dedicated to providing
                    convenient campus dining information and
                    catering services to the university community.
                    Our platform helps students and staff discover
                    available dining locations and menus.
                </p>

                <div class="features">

                    <div class="feature">
                        <div class="icon">🍽️</div>
                        <h3>Quality Dining</h3>
                        <p>Discover different campus dining options.</p>
                    </div>

                    <div class="feature">
                        <div class="icon">📋</div>
                        <h3>Menu Access</h3>
                        <p>Explore the available menus at our cafeterias.</p>
                    </div>

                    <div class="feature">
                        <div class="icon">🤝</div>
                        <h3>Customer Care</h3>
                        <p>We value the opinions of our campus community.</p>
                    </div>

                </div>
            </div>
        </section>

        <!-- CONTACT -->
        <section class="contact-section" id="contact">

            <div class="contact-content">
                <div class="section-heading">
                    <small>Get In Touch</small>
                    <h2>Contact Us</h2>
                </div>

                <p>
                    Have a question or suggestion about our
                    cafeteria services? Contact our catering department.
                </p>

                <a class="contact-email"
                   href="mailto:catering@dkut.ac.ke">
                    catering@dkut.ac.ke
                </a>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer>
        <div class="footer-logo">DeKUT Cafeteria</div>

        <p>
            Dedan Kimathi University of Technology
        </p>

        <p>
            © <span id="year"></span> DeKUT Cafeteria.
            All rights reserved.
        </p>
    </footer>

    <!-- MENU POPUP -->
    <div class="modal" id="menuModal"
         role="dialog" aria-modal="true"
         aria-labelledby="modalTitle">

        <div class="modal-content">
            <button class="close-modal"
                    onclick="closeMenu()"
                    aria-label="Close menu">
                &times;
            </button>

            <h2 id="modalTitle">Cafeteria Menu</h2>

            <p>Welcome to our dining location!</p>

            <ul>
                <li>Breakfast options</li>
                <li>Lunch options</li>
                <li>Supper options</li>
            </ul>

            <p class="demo-note">
                This is a preliminary menu preview.
                Actual food items, prices and daily menus
                will be connected to our database in a later phase.
            </p>
        </div>
    </div>

    <!-- JAVASCRIPT -->
    <script>
        const menuToggle = document.getElementById("menuToggle");
        const navigation = document.getElementById("navigation");
        const menuModal = document.getElementById("menuModal");
        const modalTitle = document.getElementById("modalTitle");

        // MOBILE NAVIGATION
        menuToggle.addEventListener("click", function () {
            navigation.classList.toggle("active");

            const expanded = navigation.classList.contains("active");
            menuToggle.setAttribute("aria-expanded", expanded);
        });

        // CLOSE MOBILE NAVIGATION AFTER CLICKING A LINK
        document.querySelectorAll("#navigation a").forEach(function(link) {
            link.addEventListener("click", function() {
                navigation.classList.remove("active");
                menuToggle.setAttribute("aria-expanded", "false");
            });
        });

        // SHOW CAFETERIA MENU PREVIEW
        function showMenu(cafeteriaName) {
            modalTitle.textContent = cafeteriaName + " Menu";
            menuModal.classList.add("active");
        }

        // CLOSE MENU POPUP
        function closeMenu() {
            menuModal.classList.remove("active");
        }

        // CLOSE POPUP WHEN CLICKING OUTSIDE IT
        menuModal.addEventListener("click", function(event) {
            if (event.target === menuModal) {
                closeMenu();
            }
        });

        // CLOSE POPUP WITH ESCAPE KEY
        document.addEventListener("keydown", function(event) {
            if (event.key === "Escape") {
                closeMenu();
            }
        });

        // AUTOMATIC COPYRIGHT YEAR
        document.getElementById("year").textContent =
            new Date().getFullYear();
    </script>

</body>
</html>
